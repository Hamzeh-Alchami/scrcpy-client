<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Width is capped in code so the form stays readable on an unfolded inner screen. -->
        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/title"
                android:textColor="@color/text"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/subtitle"
                android:textColor="@color/text_dim"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/url_label"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/field_bg"
                android:hint="@string/url_hint"
                android:imeOptions="actionGo"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:padding="14dp"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="#55FFFFFF"
                android:textSize="16sp" />

            <Button
                android:id="@+id/connect"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/btn_bg"
                android:text="@string/connect"
                android:textAllCaps="false"
                android:textColor="#FF0B1F13"
                android:textSize="17sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/optHideToolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/opt_hide_toolbar"
                android:textColor="@color/text" />

            <CheckBox
                android:id="@+id/optReloadOnResize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/opt_reload_on_resize"
                android:textColor="@color/text" />

            <CheckBox
                android:id="@+id/optKeepScreenOn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/opt_keep_screen_on"
                android:textColor="@color/text" />

            <CheckBox
                android:id="@+id/optAutoConnect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/opt_auto_connect"
                android:textColor="@color/text" />

            <TextView
                android:id="@+id/recentLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/recent"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/recentList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/help"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>
</ScrollView>
